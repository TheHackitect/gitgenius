[Unit]
Description=GitGenius Worker - Background Job Processor
Documentation=https://github.com/yourusername/gitgenius
After=network.target postgresql.service redis.service gitgenius.service

[Service]
Type=simple
User=gitgenius
Group=gitgenius
WorkingDirectory=/opt/gitgenius
ExecStart=/usr/bin/node dist/workers/automation-worker.js
Restart=always
RestartSec=10

# Environment
Environment=NODE_ENV=production
EnvironmentFile=/opt/gitgenius/.env

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gitgenius

# Logging
StandardOutput=append:/var/log/gitgenius/worker.log
StandardError=append:/var/log/gitgenius/worker-error.log

# Resource limits
LimitNOFILE=65535
MemoryMax=256M

[Install]
WantedBy=multi-user.target
