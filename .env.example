# ===========================================
# GitGenius Environment Configuration
# ===========================================

# ===========================================
# PORT CONFIGURATION
# ===========================================
# Define all service ports here for easy management
# on servers with multiple applications

# Next.js Application Port
PORT=3000

# PostgreSQL Database Port
DB_PORT=5432

# Redis Port (for BullMQ job queue)
REDIS_PORT=6379

# ===========================================
# APPLICATION SETTINGS
# ===========================================

NODE_ENV=development

# Application URL (used for OAuth callbacks, links, etc.)
# Use your server IP or domain + the PORT defined above
# Examples:
#   http://localhost:3000          (local development)
#   http://192.168.1.100:3000      (LAN IP + port)
#   http://45.33.32.156:8080       (public IP + custom port)
#   https://gitgenius.example.com  (domain with SSL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

DB_HOST=localhost
DB_NAME=gitgenius
DB_USER=postgres
DB_PASSWORD=your-secure-password-here

# Full connection URL
# Format: postgresql://USER:PASSWORD@HOST:DB_PORT/DATABASE?schema=public
# Make sure to update this if you change DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, or DB_NAME
DATABASE_URL="postgresql://postgres:your-secure-password-here@localhost:5432/gitgenius?schema=public"

# ===========================================
# REDIS CONFIGURATION
# ===========================================

REDIS_HOST=localhost

# Full Redis URL
# Format: redis://HOST:REDIS_PORT
# Update this if you change REDIS_HOST or REDIS_PORT
REDIS_URL="redis://localhost:6379"

# Authentication
# NEXTAUTH_URL must match your GitHub OAuth callback URL exactly!
# Use the same format as NEXT_PUBLIC_APP_URL above
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-nextauth-key-change-me-in-production

# GitHub OAuth App
# Create at: https://github.com/settings/developers
# 
# IMPORTANT for IP:PORT setup:
# - Homepage URL: http://YOUR_IP:YOUR_PORT
# - Callback URL: http://YOUR_IP:YOUR_PORT/api/auth/callback/github
#
# Example for http://192.168.1.50:3000:
# - Homepage URL: http://192.168.1.50:3000
# - Callback URL: http://192.168.1.50:3000/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Encryption key for storing GitHub access tokens
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# Automation Settings
# How often to run the automation check (in minutes)
AUTOMATION_CHECK_INTERVAL=15

# Max commits per day per account (to avoid suspicious activity)
MAX_COMMITS_PER_DAY=10

# Git configuration for commits
DEFAULT_GIT_NAME="GitGenius Bot"
DEFAULT_GIT_EMAIL="bot@gitgenius.dev"

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

VAPID_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_SUBJECT=mailto:xxxxxxxxxxxx