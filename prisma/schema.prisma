// GitGenius Database Schema
// Sophisticated multi-account GitHub automation platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// User Management
// ===========================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  password      String?   // For email/password auth
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Admin/Role fields
  role          String    @default("user") // user, admin, superadmin
  isActive      Boolean   @default(true)
  isBanned      Boolean   @default(false)
  bannedReason  String?
  lastLoginAt   DateTime?
  lastLoginIp   String?

  // Relations
  accounts         Account[]
  sessions         Session[]
  githubAccounts   GitHubAccount[]
  activityLogs     ActivityLog[]
  notifications    Notification[]
  settings         UserSettings?
  pushSubscriptions PushSubscription[]
  locations        UserLocation[]
  
  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Notification preferences
  emailNotifications    Boolean  @default(true)
  pushNotifications     Boolean  @default(true)
  weeklyReport          Boolean  @default(true)
  
  // Display preferences
  theme                 String   @default("system") // light, dark, system
  timezone              String   @default("UTC")
  
  // Default automation settings
  defaultCommitFrequency    String   @default("balanced") // minimal, balanced, active, aggressive
  defaultAutoCommitEnabled  Boolean  @default(false)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ===========================================
// GitHub Account Management
// ===========================================

model GitHubAccount {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // GitHub user info
  githubId        String   @unique
  username        String
  displayName     String?
  email           String?
  avatarUrl       String?
  profileUrl      String?
  
  // OAuth tokens (encrypted)
  accessToken     String   @db.Text
  refreshToken    String?  @db.Text
  tokenExpiresAt  DateTime?
  scopes          String[] @default([])
  
  // Account status
  isActive        Boolean  @default(true)
  isPrimary       Boolean  @default(false)
  lastSyncAt      DateTime?
  lastCommitAt    DateTime?
  
  // Stats cache
  totalRepos      Int      @default(0)
  totalCommits    Int      @default(0)
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  repositories        Repository[]
  automationConfigs   AutomationConfig[]
  automationJobs      AutomationJob[]
  commitHistory       CommitRecord[]
  contributionDays    ContributionDay[]

  @@index([userId])
  @@index([githubId])
  @@index([username])
}

// ===========================================
// Repository Management
// ===========================================

model Repository {
  id              String   @id @default(cuid())
  githubAccountId String
  githubAccount   GitHubAccount @relation(fields: [githubAccountId], references: [id], onDelete: Cascade)
  
  // GitHub repo info
  githubRepoId    String
  name            String
  fullName        String
  description     String?
  htmlUrl         String
  cloneUrl        String
  sshUrl          String
  
  // Repo details
  isPrivate       Boolean  @default(false)
  isFork          Boolean  @default(false)
  isArchived      Boolean  @default(false)
  defaultBranch   String   @default("main")
  language        String?
  
  // Stats
  stars           Int      @default(0)
  forks           Int      @default(0)
  watchers        Int      @default(0)
  openIssues      Int      @default(0)
  size            Int      @default(0)
  
  // Automation settings for this repo
  isAutomationEnabled  Boolean  @default(false)
  automationPriority   Int      @default(5) // 1-10, higher = more likely to be picked
  
  // Timestamps
  lastCommitAt    DateTime?
  lastPushedAt    DateTime?
  repoCreatedAt   DateTime?
  repoUpdatedAt   DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  commits         CommitRecord[]

  @@unique([githubAccountId, githubRepoId])
  @@index([githubAccountId])
  @@index([isAutomationEnabled])
}

// ===========================================
// Automation System
// ===========================================

model AutomationConfig {
  id              String   @id @default(cuid())
  githubAccountId String
  githubAccount   GitHubAccount @relation(fields: [githubAccountId], references: [id], onDelete: Cascade)
  
  // Config name and status
  name            String
  description     String?
  isEnabled       Boolean  @default(true)
  
  // Schedule settings
  scheduleType    String   @default("smart") // smart, fixed, random, weekdays_only
  cronExpression  String?  // For fixed schedule
  timezone        String   @default("UTC")
  
  // Commit settings
  minCommitsPerDay    Int      @default(1)
  maxCommitsPerDay    Int      @default(5)
  preferredHoursStart Int      @default(9)  // 24-hour format
  preferredHoursEnd   Int      @default(18)
  
  // Content settings
  commitTypes     String[] @default(["readme_update", "config_tweak", "doc_improvement"])
  commitMessageStyle  String   @default("conventional") // conventional, casual, technical
  
  // Safety settings
  skipWeekends    Boolean  @default(false)
  skipHolidays    Boolean  @default(false)
  maxStreakDays   Int      @default(365)
  
  // Variability settings (to appear more human)
  variabilityFactor   Float    @default(0.3) // 0-1, how random the timing should be
  skipProbability     Float    @default(0.1) // Chance to skip a day (more realistic)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([githubAccountId])
  @@index([isEnabled])
}

model AutomationJob {
  id              String   @id @default(cuid())
  githubAccountId String
  githubAccount   GitHubAccount @relation(fields: [githubAccountId], references: [id], onDelete: Cascade)
  
  // Job details
  jobType         String   // commit, repo_update, profile_update, etc.
  status          String   @default("pending") // pending, running, completed, failed, cancelled
  priority        Int      @default(5) // 1-10
  
  // Scheduling
  scheduledFor    DateTime
  startedAt       DateTime?
  completedAt     DateTime?
  
  // Execution details
  attempts        Int      @default(0)
  maxAttempts     Int      @default(3)
  lastError       String?  @db.Text
  
  // Payload/Result
  payload         Json?    // Job-specific data
  result          Json?    // Result data
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([githubAccountId])
  @@index([status])
  @@index([scheduledFor])
}

// ===========================================
// Analytics & Tracking
// ===========================================

model CommitRecord {
  id              String   @id @default(cuid())
  githubAccountId String
  githubAccount   GitHubAccount @relation(fields: [githubAccountId], references: [id], onDelete: Cascade)
  repositoryId    String?
  repository      Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  
  // Commit details
  sha             String
  message         String
  branch          String
  
  // Source
  isAutomated     Boolean  @default(false)
  automationJobId String?
  
  // Stats
  additions       Int      @default(0)
  deletions       Int      @default(0)
  changedFiles    Int      @default(0)
  
  // Timestamps
  committedAt     DateTime
  pushedAt        DateTime?
  
  createdAt       DateTime @default(now())

  @@index([githubAccountId])
  @@index([repositoryId])
  @@index([committedAt])
  @@index([isAutomated])
}

model ContributionDay {
  id              String   @id @default(cuid())
  githubAccountId String
  githubAccount   GitHubAccount @relation(fields: [githubAccountId], references: [id], onDelete: Cascade)
  
  date            DateTime @db.Date
  contributionCount Int    @default(0)
  level           Int      @default(0) // 0-4, matches GitHub's color levels
  
  // Breakdown
  commits         Int      @default(0)
  pullRequests    Int      @default(0)
  issues          Int      @default(0)
  reviews         Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([githubAccountId, date])
  @@index([githubAccountId])
  @@index([date])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Activity details
  action    String   // login, logout, add_account, remove_account, enable_automation, etc.
  category  String   // auth, account, automation, settings, etc.
  details   Json?    // Additional context
  
  // Metadata
  ipAddress String?
  userAgent String?
  
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ===========================================
// Commit Templates & Content
// ===========================================

model CommitTemplate {
  id          String   @id @default(cuid())
  
  // Template info
  name        String
  description String?
  category    String   // readme, docs, config, code, misc
  
  // Template content
  filePatterns    String[] // Files this template can modify
  contentTemplate String   @db.Text // Template for file content changes
  messageTemplate String   // Template for commit message
  
  // Usage
  isActive    Boolean  @default(true)
  isBuiltIn   Boolean  @default(false)
  usageCount  Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

// ===========================================
// Notifications
// ===========================================

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Notification content
  type        String   // job_completed, job_failed, streak_milestone, account_warning, system, broadcast
  title       String
  message     String
  icon        String?  // Icon name or emoji
  
  // Link to related resource
  resourceType String? // job, account, repository
  resourceId   String?
  actionUrl    String?
  
  // Broadcast notification link
  broadcastId  String?
  broadcast    BroadcastNotification? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  
  // Status
  isRead      Boolean  @default(false)
  isArchived  Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([broadcastId])
}

// ===========================================
// Push Notifications
// ===========================================

model PushSubscription {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Web Push subscription
  endpoint    String   @unique
  p256dh      String   @db.Text
  auth        String   @db.Text
  
  // Device info
  deviceName  String?
  userAgent   String?
  
  // Status
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([isActive])
}

// ===========================================
// User Location (for analytics and scheduling)
// ===========================================

model UserLocation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Location data
  latitude    Float
  longitude   Float
  accuracy    Float?
  altitude    Float?
  altitudeAccuracy Float?
  heading     Float?
  speed       Float?
  
  // Reverse geocoded info
  country     String?
  countryCode String?
  region      String?
  city        String?
  postalCode  String?
  timezone    String?
  
  // Metadata
  source      String   @default("gps") // gps, network, ip
  ipAddress   String?
  
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ===========================================
// Broadcast Notifications (Admin)
// ===========================================

model BroadcastNotification {
  id          String   @id @default(cuid())
  
  // Content (Markdown supported)
  title       String
  message     String   @db.Text
  icon        String?
  actionUrl   String?
  
  // Targeting
  targetRole  String?  // null = all users, or "user", "admin"
  targetUserIds String[] // Specific user IDs, empty = all
  
  // Scheduling
  scheduledFor DateTime?
  sentAt      DateTime?
  
  // Stats
  totalSent   Int      @default(0)
  totalRead   Int      @default(0)
  
  // Status
  status      String   @default("draft") // draft, scheduled, sent, cancelled
  
  // Creator
  createdBy   String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  notifications Notification[]

  @@index([status])
  @@index([scheduledFor])
}

// ===========================================
// App Settings (Admin controlled)
// ===========================================

model AppSettings {
  id          String   @id @default(cuid())
  
  key         String   @unique
  value       String   @db.Text
  type        String   @default("string") // string, json, boolean, number
  description String?
  
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// ===========================================
// Legal Pages (Admin editable)
// ===========================================

model LegalPage {
  id          String   @id @default(cuid())
  
  slug        String   @unique // terms, privacy, etc.
  title       String
  content     String   @db.Text // Markdown content
  
  isPublished Boolean  @default(true)
  publishedAt DateTime?
  
  // Version control
  version     Int      @default(1)
  
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}
